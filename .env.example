PORT=3000
SYNK_DATABASE_PATH=data/synk.db
SYNK_ADMIN_EMAIL=
# Generate with: npm run hash-synk-password -- "choose-a-strong-password"
SYNK_ADMIN_PASSWORD_HASH=
SYNK_SESSION_SECRET=
COOKIE_SECURE=false
RESEND_API_KEY=
RESEND_FROM=
PUBLIC_BASE_URL=
SHOP_URL=
UNSUBSCRIBE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTFUL_API_TOKEN=
# Required only when PRINTFUL_API_TOKEN is account-level rather than store-specific
PRINTFUL_STORE_ID=
# Keep false while testing; set true only when paid orders should submit immediately
PRINTFUL_AUTO_CONFIRM=false
STORE_CURRENCY=usd
# Flat amount in the currency's smallest unit; choose 0 only for free shipping
STORE_SHIPPING_CENTS=
STORE_ALLOWED_COUNTRIES=US